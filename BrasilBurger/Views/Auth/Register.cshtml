@model RegisterViewModel
@{
    ViewData["Title"] = "Inscription";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="fas fa-user-plus fa-3x text-danger mb-3"></i>
                        <h2 class="fw-bold">Créer un compte</h2>
                        <p class="text-muted">Rejoignez Brasil Burger</p>
                    </div>

                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Prenom" class="form-label fw-bold">
                                    <i class="fas fa-user"></i> Prénom
                                </label>
                                <input asp-for="Prenom" class="form-control" placeholder="Prénom" />
                                <span asp-validation-for="Prenom" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Nom" class="form-label fw-bold">
                                    <i class="fas fa-user"></i> Nom
                                </label>
                                <input asp-for="Nom" class="form-control" placeholder="Nom" />
                                <span asp-validation-for="Nom" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold">
                                <i class="fas fa-envelope"></i> Email
                            </label>
                            <input asp-for="Email" class="form-control" placeholder="votre@email.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Telephone" class="form-label fw-bold">
                                <i class="fas fa-phone"></i> Téléphone
                            </label>
                            <input asp-for="Telephone" class="form-control" placeholder="+221 XX XXX XX XX" />
                            <span asp-validation-for="Telephone" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Adresse" class="form-label fw-bold">
                                <i class="fas fa-map-marker-alt"></i> Adresse
                            </label>
                            <input asp-for="Adresse" class="form-control" placeholder="Votre adresse" />
                            <span asp-validation-for="Adresse" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-bold">
                                <i class="fas fa-lock"></i> Mot de passe
                            </label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                            <small class="form-text text-muted">Au moins 6 caractères</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold">
                                <i class="fas fa-lock"></i> Confirmer le mot de passe
                            </label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-danger btn-lg">
                                <i class="fas fa-user-plus"></i> S'inscrire
                            </button>
                        </div>

                        <div class="text-center">
                            <p class="mb-0">Vous avez déjà un compte ?</p>
                            <a asp-action="Login" class="text-danger fw-bold">Se connecter</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}