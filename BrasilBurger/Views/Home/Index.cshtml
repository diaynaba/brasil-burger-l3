@model CatalogueViewModel
@{
    ViewData["Title"] = "Accueil";
}

<!-- Hero Section -->
<section class="hero-section text-white text-center py-5" style="background: linear-gradient(rgba(220, 53, 69, 0.9), rgba(220, 53, 69, 0.9)), url('https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=1200') center/cover;">
    <div class="container">
        <h1 class="display-3 fw-bold mb-4">Bienvenue chez Brasil Burger</h1>
        <p class="lead mb-4">Découvrez nos délicieux burgers artisanaux préparés avec passion</p>
        <a asp-controller="Catalogue" asp-action="Index" class="btn btn-warning btn-lg text-dark fw-bold">
            <i class="fas fa-utensils"></i> Voir le Menu
        </a>
    </div>
</section>

<!-- Features Section -->
<section class="py-5">
    <div class="container">
        <div class="row text-center">
            <div class="col-md-4 mb-4">
                <div class="feature-box p-4">
                    <i class="fas fa-fire fa-3x text-danger mb-3"></i>
                    <h4>Fraîcheur Garantie</h4>
                    <p>Ingrédients frais sélectionnés quotidiennement</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="feature-box p-4">
                    <i class="fas fa-truck fa-3x text-danger mb-3"></i>
                    <h4>Livraison Rapide</h4>
                    <p>Livraison à domicile en moins de 30 minutes</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="feature-box p-4">
                    <i class="fas fa-star fa-3x text-danger mb-3"></i>
                    <h4>Qualité Premium</h4>
                    <p>Les meilleurs burgers de la ville</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Popular Burgers Section -->
<section class="py-5 bg-light">
    <div class="container">
        <h2 class="text-center mb-5 fw-bold">Nos Burgers Populaires</h2>
        <div class="row">
            @foreach (var burger in Model.Burgers)
            {
                <div class="col-md-4 mb-4">
                    <div class="card product-card h-100 shadow-sm">
                        <img src="@burger.ImageUrl" class="card-img-top" alt="@burger.Nom" style="height: 250px; object-fit: cover;">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold">@burger.Nom</h5>
                            <p class="card-text text-muted flex-grow-1">@burger.Description</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-danger fw-bold fs-5">@burger.Prix.ToString("N0") FCFA</span>
                                <a asp-controller="Catalogue" asp-action="BurgerDetail" asp-route-id="@burger.Id" class="btn btn-danger">
                                    Détails <i class="fas fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="text-center mt-4">
            <a asp-controller="Catalogue" asp-action="Index" asp-route-filter="burgers" class="btn btn-outline-danger btn-lg">
                Voir tous les Burgers <i class="fas fa-chevron-right"></i>
            </a>
        </div>
    </div>
</section>

<!-- Menus Section -->
<section class="py-5">
    <div class="container">
        <h2 class="text-center mb-5 fw-bold">Nos Menus</h2>
        <div class="row">
            @foreach (var menu in Model.Menus)
            {
                <div class="col-md-6 mb-4">
                    <div class="card menu-card h-100 shadow-sm">
                        <div class="row g-0">
                            <div class="col-md-5">
                                <img src="@menu.ImageUrl" class="img-fluid h-100" alt="@menu.Nom" style="object-fit: cover;">
                            </div>
                            <div class="col-md-7">
                                <div class="card-body d-flex flex-column h-100">
                                    <h5 class="card-title fw-bold">@menu.Nom</h5>
                                    <p class="card-text text-muted flex-grow-1">@menu.Description</p>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-danger fw-bold fs-5">@menu.Prix.ToString("N0") FCFA</span>
                                        <a asp-controller="Catalogue" asp-action="MenuDetail" asp-route-id="@menu.Id" class="btn btn-danger">
                                            Commander
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="text-center mt-4">
            <a asp-controller="Catalogue" asp-action="Index" asp-route-filter="menus" class="btn btn-outline-danger btn-lg">
                Voir tous les Menus <i class="fas fa-chevron-right"></i>
            </a>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta-section py-5 text-white text-center" style="background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);">
    <div class="container">
        <h2 class="mb-4 fw-bold">Prêt à commander ?</h2>
        <p class="lead mb-4">Inscrivez-vous maintenant et profitez de nos offres exclusives</p>
        @if (!User.Identity.IsAuthenticated)
        {
            <a asp-controller="Auth" asp-action="Register" class="btn btn-warning btn-lg text-dark fw-bold">
                <i class="fas fa-user-plus"></i> Créer un compte
            </a>
        }
        else
        {
            <a asp-controller="Catalogue" asp-action="Index" class="btn btn-warning btn-lg text-dark fw-bold">
                <i class="fas fa-shopping-cart"></i> Commander maintenant
            </a>
        }
    </div>
</section>