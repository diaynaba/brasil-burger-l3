@model MesCommandesViewModel
@{
    ViewData["Title"] = "Mes Commandes";
}

<div class="container py-5">
    <h1 class="display-4 fw-bold mb-4"><i class="fas fa-receipt text-danger"></i> Mes Commandes</h1>

    <ul class="nav nav-tabs mb-4" id="commandeTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="encours-tab" data-bs-toggle="tab" data-bs-target="#encours" type="button">
                <i class="fas fa-clock"></i> En cours (@Model.CommandesEnCours.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="terminees-tab" data-bs-toggle="tab" data-bs-target="#terminees" type="button">
                <i class="fas fa-check-circle"></i> Terminées (@Model.CommandesTerminees.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="annulees-tab" data-bs-toggle="tab" data-bs-target="#annulees" type="button">
                <i class="fas fa-times-circle"></i> Annulées (@Model.CommandesAnnulees.Count)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="commandeTabContent">
        <!-- Commandes en cours -->
        <div class="tab-pane fade show active" id="encours" role="tabpanel">
            @if (Model.CommandesEnCours.Any())
            {
                @foreach (var commande in Model.CommandesEnCours)
                {
                    <div class="card mb-3 shadow-sm">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-8">
                                    <h5 class="fw-bold mb-2">
                                        <i class="fas fa-hashtag text-danger"></i> @commande.NumeroCommande
                                    </h5>
                                    <p class="mb-1">
                                        <i class="fas fa-calendar"></i> @commande.DateCommande.ToString("dd/MM/yyyy HH:mm")
                                    </p>
                                    <p class="mb-1">
                                        <i class="fas fa-truck"></i> @commande.TypeService
                                    </p>
                                    <span class="@commande.EtatBadgeClass">@commande.Etat</span>
                                    @if (commande.IsPaye)
                                    {
                                        <span class="badge bg-success ms-2"><i class="fas fa-check"></i> Payé</span>
                                    }
                                </div>
                                <div class="col-md-4 text-md-end">
                                    <h4 class="text-danger fw-bold mb-3">@commande.MontantTotal.ToString("N0") FCFA</h4>
                                    <a asp-action="Detail" asp-route-id="@commande.Id" class="btn btn-outline-danger">
                                        <i class="fas fa-eye"></i> Détails
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
                    <h4>Aucune commande en cours</h4>
                    <a asp-controller="Catalogue" asp-action="Index" class="btn btn-danger mt-3">
                        <i class="fas fa-shopping-cart"></i> Commander maintenant
                    </a>
                </div>
            }
        </div>

        <!-- Commandes terminées -->
        <div class="tab-pane fade" id="terminees" role="tabpanel">
            @if (Model.CommandesTerminees.Any())
            {
                @foreach (var commande in Model.CommandesTerminees)
                {
                    <div class="card mb-3 shadow-sm">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-8">
                                    <h5 class="fw-bold mb-2">
                                        <i class="fas fa-hashtag text-success"></i> @commande.NumeroCommande
                                    </h5>
                                    <p class="mb-1">
                                        <i class="fas fa-calendar"></i> @commande.DateCommande.ToString("dd/MM/yyyy HH:mm")
                                    </p>
                                    <p class="mb-1">
                                        <i class="fas fa-truck"></i> @commande.TypeService
                                    </p>
                                    <span class="@commande.EtatBadgeClass">@commande.Etat</span>
                                </div>
                                <div class="col-md-4 text-md-end">
                                    <h4 class="text-success fw-bold mb-3">@commande.MontantTotal.ToString("N0") FCFA</h4>
                                    <a asp-action="Detail" asp-route-id="@commande.Id" class="btn btn-outline-success">
                                        <i class="fas fa-eye"></i> Détails
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
                    <h4>Aucune commande terminée</h4>
                </div>
            }
        </div>

        <!-- Commandes annulées -->
        <div class="tab-pane fade" id="annulees" role="tabpanel">
            @if (Model.CommandesAnnulees.Any())
            {
                @foreach (var commande in Model.CommandesAnnulees)
                {
                    <div class="card mb-3 shadow-sm">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-8">
                                    <h5 class="fw-bold mb-2">
                                        <i class="fas fa-hashtag text-danger"></i> @commande.NumeroCommande
                                    </h5>
                                    <p class="mb-1">
                                        <i class="fas fa-calendar"></i> @commande.DateCommande.ToString("dd/MM/yyyy HH:mm")
                                    </p>
                                    <p class="mb-1">
                                        <i class="fas fa-truck"></i> @commande.TypeService
                                    </p>
                                    <span class="@commande.EtatBadgeClass">@commande.Etat</span>
                                </div>
                                <div class="col-md-4 text-md-end">
                                    <h4 class="text-muted fw-bold mb-3">@commande.MontantTotal.ToString("N0") FCFA</h4>
                                    <a asp-action="Detail" asp-route-id="@commande.Id" class="btn btn-outline-secondary">
                                        <i class="fas fa-eye"></i> Détails
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-smile fa-4x text-muted mb-3"></i>
                    <h4>Aucune commande annulée</h4>
                    <p class="text-muted">C'est une bonne nouvelle !</p>
                </div>
            }
        </div>
    </div>
</div>